# =============================================================================
# AI Reviewer — Configuración de Seguridad npm
# =============================================================================
# Estas configuraciones protegen contra la ejecución de scripts maliciosos
# durante la instalación de dependencias y contra paquetes recién publicados.
#
# Para aplicar globalmente en tu sistema:
#   npm config set ignore-scripts true
#   npm config set engine-strict true
#   npm config set min-release-age 2d
# =============================================================================

ignore-scripts=true
engine-strict=true
min-release-age=2d
